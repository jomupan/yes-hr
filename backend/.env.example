# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
# Public URL of the frontend (used to build password reset links)
FRONTEND_URL=http://localhost:8080
# Business timezone: used for "today", late check (after 08:15), etc.
APP_TIMEZONE=Asia/Kuala_Lumpur

# ── Auth ────────────────────────────────────────────────
# CHANGE THIS in production. Any long random string works.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ── Database ────────────────────────────────────────────
# sqlite (default, zero setup) | mysql | pg
DB_CLIENT=sqlite
SQLITE_FILE=./data/yeselevate.db
# For mysql / pg, set a connection URL instead, e.g.
# DATABASE_URL=mysql://root:password@localhost:3306/yeselevate
# DATABASE_URL=postgres://postgres:password@localhost:5432/yeselevate

# ── Files ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Seed accounts (created on first `npm run seed`) ─────
SEED_ADMIN_PASSWORD=admin123
SEED_STAFF_PASSWORD=staff123
