{
  "name": "yeselevate-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API backend for the YES Elevate HR system (staff portal + admin portal).",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "app": "npm --prefix .. run build && tsx src/server.ts",
    "migrate": "tsx src/db/cli.ts migrate",
    "seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.1",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "knex": "3.1.0",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "web-push": "^3.6.7",
    "zod": "3.24.1"
  },
  "optionalDependencies": {
    "mysql2": "3.24.5",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "@types/web-push": "^3.6.4",
    "supertest": "7.2.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
